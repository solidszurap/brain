# Ember's voice. Copy this file to a file named .env in the same folder and
# fill in ONE option. .env is never committed to git (it is in .gitignore).
# Restart Ember after changing it. With nothing set, Ember uses its simple
# template voice, which needs no key and never makes anything up.

# Which voice: auto (the first key found below), template, anthropic, gemini, openai, ollama
EMBER_VOICE=auto

# Option 1: Gemini. Has a free tier. Key: https://aistudio.google.com/apikey
# (On the free tier, Google may use what is sent to improve its products.)
# GEMINI_API_KEY=

# Option 2: Claude. Key: https://console.anthropic.com
# The default, Claude Haiku 5.5, costs about a tenth of a cent per question (answer + check).
# ANTHROPIC_API_KEY=

# Option 3: Ollama. Free, runs on your own computer: https://ollama.com
# then e.g. `ollama pull llama3.2` (bigger models follow the JSON format more reliably)
# EMBER_VOICE=ollama
# EMBER_VOICE_MODEL=llama3.2

# Option 4: any OpenAI-compatible server (OpenAI, OpenRouter, LM Studio, ...)
# EMBER_VOICE=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# EMBER_VOICE_MODEL=

# Use a different model (defaults: claude-haiku-5-5, gemini-3.8-flash, llama3.2)
# EMBER_VOICE_MODEL=

# The judge: a second call that checks every answer against Ember's memory and
# catches anything said without a memory behind it. 1 = on (default), 0 = off.
# EMBER_VOICE_JUDGE=1
